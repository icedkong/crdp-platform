          "key": "f011",
          "categoryKey": "basic_info",
          "type": "number",
          "hardRange": { "min": 50, "max": 250 },
          "softRange": { "min": 130, "max": 210 }
        }
      ],
      "rules": [],
      "data": { "f011": 300 },
      "expectedErrors": [
        {
          "key": "f011",
          "categoryKey": "basic_info",
          "rule": "hardRange",
          "message": "取值应在 50–250 之间"
        }
      ],
      "expectedWarnings": []
    },
    {
      "name": "A-FLD-003 软范围外可保存（身高 120 在硬范围内、低于软下限 130）",
      "fields": [
        {
          "key": "f011",
          "categoryKey": "basic_info",
          "type": "number",
          "hardRange": { "min": 50, "max": 250 },
          "softRange": { "min": 130, "max": 210 }
        }
      ],
      "rules": [],
      "data": { "f011": 120 },
      "expectedErrors": [],
      "expectedWarnings": [
        {
          "key": "f011",
          "categoryKey": "basic_info",
          "rule": "softRange",
          "message": "取值应在 130–210 之间"
        }
      ]
    },
    {
