{
  "comment": "E11-T04 前后端共用校验用例（components.md §10.5）：同一份文件由后端 FormRuleEngine（FormRuleEngineTest）与前端 @crdp/rules（form-validation.test）各执行一遍，errors / warnings 逐条（key、categoryKey、rule、message）完全一致才通过。用例取自需求验收标准：A-FLD-003（超出硬范围不可保存、软范围提示但可保存）、A-FLD-006（入院 ≤ 手术 ≤ 出院、手术开始 < 结束、进 ICU < 出 ICU、死亡日期 ≥ 出院日期）、C-FLD-007（建议范围软提示、格式错误由类型闸门拦截、上限频率须大于下限频率）。字段与规则全部虚构（示例），真实字段与规则随 E23-T01 录入。",
  "shape": {
    "fields[]": "参与校验的字段：key 稳定键、categoryKey 分类锚点键、type 为 components.md §10.1 类型、hardRange/softRange 为 {min,max}（空端不限制）",
    "rules[]": "fe_rule 下发口径：id 规则稳定编码、severity HARD|SOFT、categoryKey、key 提示挂靠字段、params {leftField, op lt|lte, rightField}、message",
    "expectedErrors[] / expectedWarnings[]": "FieldIssue：key、categoryKey、rule（hardRange / softRange / 规则 id）、message"
  },
  "cases": [
    {
      "name": "A-FLD-003 硬范围边界值通过（身高 50 = 硬下限），软范围外仅提示",
      "fields": [
        {
          "key": "f011",
          "categoryKey": "basic_info",
          "type": "number",
          "hardRange": { "min": 50, "max": 250 },
          "softRange": { "min": 130, "max": 210 }
        }
      ],
      "rules": [],
      "data": { "f011": 50 },
      "expectedErrors": [],
      "expectedWarnings": [
        {
          "key": "f011",
          "categoryKey": "basic_info",
          "rule": "softRange",
          "message": "取值应在 130–210 之间"
        }
      ]
    },
    {
      "name": "A-FLD-003 超出硬范围拦截（身高 300 > 硬上限 250），同字段不再叠加软提示",
