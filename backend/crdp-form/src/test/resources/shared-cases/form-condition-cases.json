{
  "comment": "E11-T03 前后端共用条件求值用例（components.md §10.5；A-FLD-004 条件显示与条件必填）：同一份文件由后端 FormConditionEngine（FormConditionEngineTest）与前端 @crdp/rules（form-condition.test）各执行一遍，visible 与 missingRequired 逐条（key、categoryKey、rule、message）完全一致才通过。用例取自需求验收标准：是否死亡=是才显示并必填死亡日期与死亡原因、选了再住院类型才显示再住院日期、复查超声=是才显示超声指标（A-FLD-004）；ICD 项目按当前器械类型、心房参数按在用 RA 电极（components.md §10.4、C-FLD-005 上下文变量）。字段全部虚构（示例），真实字段随 E23-T01 录入。求值语义（form.md §2.4）：操作数缺失（未答 / null）除 empty / notEmpty 外一律不成立；eq / in 按值编码口径严格同型比较（1 与 \"1\" 不等）；条件为空恒真。",
  "shape": {
    "fields[]": "参与求值的字段：key 稳定键、categoryKey 分类锚点键、type（可省）、storage（可省，默认 json）、required（可省，默认 false）、visibleWhen / requiredWhen 条件树（可省 = 无条件：恒显示 / 不加必填）",
    "data": "表单值（键 = 稳定键，值按 tech-plan §6 值编码）",
    "context": "条件上下文（可省）：ctx 按点路径取值（如 device.type），来源 C 器械上下文（E21-T03）等业务侧",
    "expectedVisible[]": "按 fields 声明序，显示字段的 key 列表（visibleWhen 求值结果）",
    "expectedMissingRequired[]": "FieldIssue：key、categoryKey、rule=required、message=必填（显示中且有效必填、值为空）"
  },
  "cases": [
    {
      "name": "A-FLD-004 是否死亡=是：死亡日期与死亡原因显示并必填",
      "fields": [
        { "key": "f215", "categoryKey": "endpoint", "type": "radio", "required": true },
        { "key": "f216", "categoryKey": "endpoint", "type": "date",
          "visibleWhen": { "all": [{ "field": "f215", "op": "eq", "value": 1 }] },
          "requiredWhen": { "all": [{ "field": "f215", "op": "eq", "value": 1 }] } },
        { "key": "f217", "categoryKey": "endpoint", "type": "text",
          "visibleWhen": { "all": [{ "field": "f215", "op": "eq", "value": 1 }] },
          "requiredWhen": { "all": [{ "field": "f215", "op": "eq", "value": 1 }] } }
      ],
      "data": { "f215": 1 },
      "expectedVisible": ["f215", "f216", "f217"],
      "expectedMissingRequired": [
        { "key": "f216", "categoryKey": "endpoint", "rule": "required", "message": "必填" },
        { "key": "f217", "categoryKey": "endpoint", "rule": "required", "message": "必填" }
      ]
    },
    {
      "name": "A-FLD-004 是否死亡=否：隐藏字段不报必填（残留值也不报）",
      "fields": [
        { "key": "f215", "categoryKey": "endpoint", "type": "radio", "required": true },
        { "key": "f216", "categoryKey": "endpoint", "type": "date",
          "visibleWhen": { "all": [{ "field": "f215", "op": "eq", "value": 1 }] },
          "requiredWhen": { "all": [{ "field": "f215", "op": "eq", "value": 1 }] } },
        { "key": "f217", "categoryKey": "endpoint", "type": "text",
          "visibleWhen": { "all": [{ "field": "f215", "op": "eq", "value": 1 }] },
          "requiredWhen": { "all": [{ "field": "f215", "op": "eq", "value": 1 }] } }
      ],
      "data": { "f215": 0, "f216": "2024-01-02", "f217": "心源性（示例）" },
      "expectedVisible": ["f215"],
      "expectedMissingRequired": []
    },
    {
      "name": "A-FLD-004 是否死亡未答：eq 操作数缺失不成立 → 后续字段隐藏；自身必填报缺失",
      "fields": [
