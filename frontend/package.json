{
  "name": "fu-frontend",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @fu/web-hospital --filter @fu/web-platform dev",
    "build": "pnpm --filter @fu/web-hospital --filter @fu/web-platform --filter @fu/mobile-upload build",
    "test": "pnpm --filter @fu/admin-shell --filter @fu/rules test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.5.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.46.2",
    "vue-eslint-parser": "^10.2.0"
  }
}
